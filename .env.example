# HabitFlow Environment Variables

# OpenAI API Key (for AI features)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# API Configuration
VITE_API_URL=http://localhost:3001/api

# Enable AI Features
VITE_ENABLE_AI=true

# Service Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_EMAIL_NOTIFICATIONS=false

# Optional: Third-party integrations
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_SLACK_WEBHOOK=your_slack_webhook_url

# Analytics
VITE_ENABLE_ANALYTICS=true

# Feature Flags
VITE_FEATURE_SOCIAL=true
VITE_FEATURE_JOURNAL=true
VITE_FEATURE_GAMIFICATION=true
VITE_FEATURE_PREDICTION=true
